# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mehfooze:password@localhost:5432/mehfooze_db

# ── External APIs ──────────────────────────────────────────────────────
AQICN_TOKEN=your_aqicn_token_here
OPENAQ_API_KEY=your_openaq_key_here

# ── Optional: Google Directions API (Travel Mode) ────────────────────
# Leave blank to fall back to OSRM / OpenStreetMap
GOOGLE_MAPS_API_KEY=

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
