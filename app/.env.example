# ── Database ──────────────────────────────────────────────────────────
# For local development (no Docker): leave as SQLite — just works.
DATABASE_URL=sqlite:///./mehfooze_dev.db

# For production (Render PostgreSQL):
# DATABASE_URL=postgresql://mehfooze:<password>@host:5432/mehfooze_db

# Docker Compose — set this env var before running docker-compose up
# NEVER use the literal word "password" here — use a strong random value
POSTGRES_PASSWORD=your_strong_password_here

# ── Firebase (Push Notifications) ────────────────────────────────────
# Download service account JSON from Firebase Console:
# Project Settings → Service Accounts → Generate New Private Key
# Set the absolute path to that file here (NEVER commit the JSON file itself)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# ── AQI Data Sources ──────────────────────────────────────────────────
# Open-Meteo (primary source) requires NO key — works out of the box.

# AQICN token — optional, adds live station cross-check.
# Get free token at: https://aqicn.org/data-platform/token/
# SECURITY: This must NEVER appear in any client-side code (web/mobile).
# Backend only.
AQICN_TOKEN=

# OpenAQ v3 key — optional backup source.
# Get free key at: https://explore.openaq.org/register
OPENAQ_API_KEY=

# ── Optional: Google Directions API (Travel Mode) ────────────────────
# Leave blank to fall back to OSRM / OpenStreetMap (free)
# SECURITY: Backend only — never put in web .env or mobile dart-define.
GOOGLE_MAPS_API_KEY=

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
