{
  "expo": {
    "name": "Mehfooze",
    "slug": "mehfooze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4fbf3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mehfooze.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4fbf3"
      },
      "package": "com.mehfooze.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#006c46"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "546e6af5-147b-4ca1-990f-9a6fcbc09e42"
      }
    },
    "owner": "meanas-dev"
  }
}
